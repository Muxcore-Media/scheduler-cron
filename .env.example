# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=scheduler-cron

# Module-specific settings
# SCHEDULER_HTTP_ADDR=:9200
# SCHEDULER_TZ=UTC
# SCHEDULER_STORE_PATH=
# SCHEDULER_CATCH_UP=true
