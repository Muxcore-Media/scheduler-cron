[Unit]
Description=MuxCore Module - scheduler-cron
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/scheduler-cron \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id scheduler-cron
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scheduler-cron

[Install]
WantedBy=multi-user.target
